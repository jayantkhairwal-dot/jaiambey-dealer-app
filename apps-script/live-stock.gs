function doGet() {
  const cache = CacheService.getScriptCache();
  let body = cache.get('stock');
  if (!body) {
    body = JSON.stringify(readStock_());
    cache.put('stock', body, CACHE_SECONDS);
  }
  return ContentService.createTextOutput(body).setMimeType(ContentService.MimeType.JSON);
}

function readStock_() {
  const id = PropertiesService.getScriptProperties().getProperty('IMS_ID');
  const sh = SpreadsheetApp.openById(id).getSheetByName(SHEET);
  const values = sh.getDataRange().getValues();
  const head = values[0];
  // Latest day column (a date in row 1) that has numbers in it
  let col = -1, day = null;
  for (let c = head.length - 1; c >= 0; c--) {
    if (!(head[c] instanceof Date)) continue;
    if (values.some((r, i) => i > 0 && typeof r[c] === 'number')) { col = c; day = head[c]; break; }
  }
  if (col < 0) col = 4;  // fall back to "Closing Stock" (column E)
  const stock = {};
  values.slice(1).forEach(r => {
    const name = String(r[NAME_COL - 1] || '').replace(/\s+/g, ' ').trim().toLowerCase();
    if (name && typeof r[col] === 'number') stock[name] = r[col];
  });
  const known = [], out = [];
  Object.keys(MAP).forEach(pid => {
    const s = stock[MAP[pid].replace(/\s+/g, ' ').trim().toLowerCase()];
    if (s === undefined) return;
    known.push(pid);
    if (s === 0) out.push(pid);
  });
  return { day: day ? Utilities.formatDate(day, 'Asia/Kolkata', 'yyyy-MM-dd') : null,
           checked: new Date().toISOString(), known: known, out: out };
}

/** Run once from the editor to test: shows how many products were found and which are sold out. */
function test() {
  const r = readStock_();
  Logger.log('IMS day: %s | found %s of %s products | sold out: %s', r.day, r.known.length, Object.keys(MAP).length, r.out.join(', '));
  const missing = Object.keys(MAP).filter(k => r.known.indexOf(k) < 0);
  if (missing.length) Logger.log('Not found in the IMS (check the name): ' + missing.map(k => k + ' = ' + MAP[k]).join(' | '));
}
